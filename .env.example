PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/Road Defect Reporting & Routing Platform
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:3000
# Required in production: use a restricted Cloudinary upload preset/account.
CLOUDINARY_URL=
STAFF_EMAIL=coordinator@kerra.go.ke
STAFF_PASSWORD=123456789
# SMTP settings for citizen status emails. Leave empty in development to log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Road Defect Reporting & Routing Platform <no-reply@example.org>
# Survey of Kenya county boundaries published through the KETRACO ArcGIS service.
BOUNDARY_GEOJSON_URL=https://services1.arcgis.com/Kw7jGaBPiN3WUAmT/ArcGIS/rest/services/final_ketraco_map/FeatureServer/0/query?where=1%3D1&outFields=*&returnGeometry=true&f=geojson&outSR=4326&resultRecordCount=100
